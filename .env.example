PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/stylehub
MONGODB_DB_NAME=stylehub
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
CLIENT_URL=http://localhost:5173

